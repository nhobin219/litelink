# Copy to `.env` IN THE REPOSITORY ROOT to point the demo at a real bucket
# instead of local rustfs. `just` loads it automatically; nothing else changes.
#
#   cp examples/.env.example .env    # then edit LITELINK_ARCHIVE
#
# The library reads credentials from the environment at the point of use and
# never writes them into the log — a log directory gets copied, backed up and
# attached elsewhere, and a key inside it travels with all of that. Leave these
# unset to use the ordinary AWS chain (profile, instance metadata, SSO).

# Where the archive tier writes. Its presence is what switches the demo off
# rustfs, so comment it out to go back to local.
LITELINK_ARCHIVE=s3://your-bucket/litelink-demo

# AWS_REGION=us-west-1
# AWS_PROFILE=default

# Only for an S3-compatible endpoint that is not AWS.
# AWS_ENDPOINT_URL=https://minio.example.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
